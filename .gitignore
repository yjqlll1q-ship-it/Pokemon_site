# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 临时工作目录（探查输出、一次性修复脚本、推送脚本等）
/.scratch

# 本地截图产物（tools/ui-check.cjs 生成）
/shots
/shots-before
/shots-run2
/shots-probe

# 视觉回归比对用的计算样式快照
/baseline-*.json
/style-snapshot*.json
/style-diff-report.md
/style-diff-current.md

# tailwind 单层编译产物（npm run tw:compile）
/tools/tw-out.css

# PokéAPI 响应缓存（scripts/build-data.mjs），删了顶多多抓一次
/.cache

# SQLite 数据库（由 data/pokedex.json 生成，脚本可随时重建）
/data/pokedex.db
/data/pokedex.db-*

# 本地跑脚本时的日志
*.log
